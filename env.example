# QuantAI — copy to .env.local (never commit secrets)

# App URL for Stripe redirects (production: https://your-domain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (existing)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Supabase (existing)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (optional rate limits)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Stripe — enable Checkout + Customer Portal
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# Optional: single Stripe Customer ID for local portal testing only
# STRIPE_CUSTOMER_ID_PLACEHOLDER=cus_xxx

# OpenAI (AI assistant)
# OPENAI_API_KEY=
