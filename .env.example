# QuantAI — environment template
# Copy to `.env.local` for local dev, OR run: npm run env:sync (pulls Vercel production)
# Never commit real secrets. Never prefix server-only secrets with `NEXT_PUBLIC_`.
# Docs: docs/ENVIRONMENT.md

# -----------------------------------------------------------------------------
# App URL (used for Stripe redirects, metadataBase, absolute links)
# -----------------------------------------------------------------------------
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel sets this automatically; appUrl() falls back to https://{VERCEL_URL} when NEXT_PUBLIC_APP_URL is unset.

# -----------------------------------------------------------------------------
# Clerk (required for auth UI and protected routes)
# https://dashboard.clerk.com → API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional custom paths (defaults work for most deployments):
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------------------------------------------------------
# Supabase (server persistence: saved products, watchlist, history, compare, feedback)
# Service role key must stay server-only — never expose via NEXT_PUBLIC_*.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Optional: only if you add client-side Supabase reads later (not required by current API routes).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apply SQL in supabase/migrations/ via Supabase CLI (`supabase db push`) or paste into the SQL editor.
# Includes search_history, user_shopping_memory, saved_products, watchlist, compare_sessions, RLS on history/memory.

# -----------------------------------------------------------------------------
# Stripe (Checkout, Customer Portal, webhooks)
# https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=
# Local portal smoke-test only — map real users to Stripe customers in production.
# STRIPE_CUSTOMER_ID_PLACEHOLDER=cus_xxx

# -----------------------------------------------------------------------------
# Product search (SerpApi → Google Shopping)
# -----------------------------------------------------------------------------
SERPAPI_KEY=

# -----------------------------------------------------------------------------
# Phase 0 — Canonical Commerce Identity / Product Normalization (default OFF)
# Commerce Intelligence OS foundation — deterministic IDs, dedup, variant collapse.
# No retrieval, no embeddings, no new intelligence layers.
# Modes: shadow | meta_only | dedup | collapse
# shadow/meta_only: attach qiNormalizedCommerce meta, do not remove listings (APPLY ignored)
# dedup/collapse + APPLY=true: remove duplicate representatives from enrichment tray
# Run: npm run test:normalization
#
# --- Stage 1 production shadow rollout (RECOMMENDED NEXT) ---
# Telemetry on live traffic, zero ranking mutation:
# QUANTAI_NORMALIZATION_ENABLED=true
# QUANTAI_NORMALIZATION_MODE=shadow
# QUANTAI_NORMALIZATION_APPLY=false
# QUANTAI_NORMALIZATION_SHADOW_TELEMETRY=true
# Optional analytics sink: QUANTAI_ANALYTICS_SINK_URL=https://your-ingest/hook
# Probe: SEARCH_BASE_URL=https://your-domain npm run test:stage1-shadow-probe
# Dashboard: npm run stage1-shadow-dashboard
#
# --- Phase 2 APPLY readiness (shadow observation — DO NOT enable APPLY in prod) ---
# npm run phase2-apply-readiness
# npm run normalization-duplicate-monitor
# Logs: quantai.normalization.shadow + quantai.normalization.shadow.audit
# QUANTAI_NORMALIZATION_APPLY=false  # REQUIRED until readiness verdict
# QUANTAI_NORMALIZATION_APPLY_PRODUCTION_CONFIRMED=false
# Staging canary only (never production without sign-off):
# QUANTAI_NORMALIZATION_APPLY_CANARY=false
# QUANTAI_NORMALIZATION_CANARY_CONFIRMED=false
# QUANTAI_NORMALIZATION_CANARY_MODE=dedup
#
# --- Phase 8 autonomous commerce OS (shadow — no ranking mutation, no agents) ---
# QUANTAI_AUTONOMOUS_COMMERCE_OS_ENABLED=true
# QUANTAI_AUTONOMOUS_COMMERCE_OS_OBSERVABILITY=true
# npm run test:market-awareness && npm run test:economic-context && npm run test:commerce-orchestration && npm run test:governance-safety
#
# --- Phase 7 recommendation cognition (shadow — no ranking mutation, no agents) ---
# QUANTAI_RECOMMENDATION_COGNITION_ENABLED=true
# QUANTAI_RECOMMENDATION_COGNITION_OBSERVABILITY=true
# npm run test:recommendation && npm run test:intent-evolution && npm run test:commerce-graph
#
# --- Phase 6 commerce memory + taste intelligence (shadow — no ranking mutation) ---
# QUANTAI_COMMERCE_MEMORY_ENABLED=true
# QUANTAI_COMMERCE_MEMORY_OBSERVABILITY=true
# npm run test:memory && npm run test:taste && npm run test:preferences
#
# --- Phase 5 trust + price truth engine (shadow — no ranking mutation) ---
# QUANTAI_TRUST_ENGINE_ENABLED=true
# QUANTAI_TRUST_ENGINE_OBSERVABILITY=true
# npm run test:trust && npm run test:pricing && npm run test:merchant-graph
#
# --- Phase 4 identity foundation (shadow — no retrieval vectors, no ranking mutation) ---
# QUANTAI_IDENTITY_FOUNDATION_ENABLED=true
# QUANTAI_IDENTITY_FOUNDATION_OBSERVABILITY=true
# npm run test:identity && npm run test:variant-boundaries
#
# --- Default (safe) ---
# QUANTAI_NORMALIZATION_ENABLED=false
# QUANTAI_IDENTITY_FOUNDATION_ENABLED=false
# QUANTAI_NORMALIZATION_MODE=shadow
# QUANTAI_NORMALIZATION_APPLY=false
# QUANTAI_NORMALIZATION_SHADOW_TELEMETRY=true

# -----------------------------------------------------------------------------
# OpenAI (AI assistant + compare verdict + batched search commerce analysis)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional: model id for search commerce batch (default gpt-4.1-mini)
# QUANTAI_COMMERCE_AI_MODEL=gpt-4.1-mini
# Optional: model for conversational copilot (defaults to a small fast model in code if unset — see lib/copilot/openaiCopilot.ts)
# QUANTAI_COPILOT_MODEL=gpt-4.1-mini

# -----------------------------------------------------------------------------
# Upstash Redis (optional — per-user rate limits when URL + token set)
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Analytics (optional — forward validated client events to your sink)
# -----------------------------------------------------------------------------
# QUANTAI_ANALYTICS_SINK_URL=https://your-ingest-endpoint.example/hook

# -----------------------------------------------------------------------------
# Phase 2 — Vertical Taste Grammar (shadow by default; no ranking apply until enabled)
# -----------------------------------------------------------------------------
# Phase 2.4 — WATCHES-ONLY canary apply (rollback: TASTE_GRAMMAR_ENABLED=false)
# TASTE_GRAMMAR_ENABLED=false
# Phase 2.5 — FRAGRANCE-ONLY canary apply (rollback: TASTE_FRAGRANCE_GRAMMAR_ENABLED=false)
# TASTE_FRAGRANCE_GRAMMAR_ENABLED=false
# Phase 2.6 — FURNITURE/DESK_SETUP-ONLY canary apply (rollback: TASTE_FURNITURE_GRAMMAR_ENABLED=false)
# TASTE_FURNITURE_GRAMMAR_ENABLED=false
# Phase 3.1 — Unified taste graph (meta on by default; apply off)
# TASTE_UNIFIED_TASTE=true
# Phase 3.2 — Unified bounded apply canary (staging only; max ±4; rollback: TASTE_UNIFIED_APPLY_ENABLED=false)
# TASTE_UNIFIED_APPLY_ENABLED=false
# Phase 3.3 — Live staging soak guard (production OFF by default; hard rollback: ENABLE_UNIFIED_CANARY=false)
# ENABLE_UNIFIED_CANARY=false
# Phase 4.0 — Intent Intelligence Engine (meta on by default; apply off; no LLM hot path)
# INTENT_INTELLIGENCE=true
# Phase 4.1 — Bounded intent apply bridge (max ±3; rollback: INTENT_INTELLIGENCE_APPLY_ENABLED=false)
# INTENT_INTELLIGENCE_APPLY_ENABLED=false
# Phase 4.2 — Staging soak + cross-layer audit (staging apply ON only; production apply OFF)
# Run: npm run test:intent-apply-p42 && npm run test:intent-apply-p42-gate
# Phase 4.3 — Production-safe intent apply (NODE_ENV=production alone does NOT activate apply)
# Staging/dev: INTENT_INTELLIGENCE_APPLY_ENABLED=true
# Production canary: INTENT_INTELLIGENCE_CANARY_APPLY=true + APPLY_ENABLED=true
# Production full: INTENT_INTELLIGENCE_PROD_APPLY=true + APPLY_ENABLED=true
# Hard rollback: INTENT_INTELLIGENCE_APPLY_ENABLED=false
# INTENT_INTELLIGENCE_PROD_APPLY=false
# INTENT_INTELLIGENCE_CANARY_APPLY=false
# Phase 4.4 — Live observability (meta.intentObservability; default on; rollback: INTENT_OBSERVABILITY=false)
# INTENT_OBSERVABILITY=true
# Run: npm run test:intent-p44
# Phase 4.5 — Real production canary rollout (bucketed; rollback: INTENT_CANARY_EMERGENCY_DISABLE=true)
# INTENT_INTELLIGENCE_CANARY_APPLY=true
# INTENT_CANARY_ROLLOUT_STAGE=1|5|10|25|50|100
# INTENT_CANARY_PERCENTAGE=5
# INTENT_CANARY_EMERGENCY_DISABLE=false
# Run: npm run test:intent-p45
# Phase 4.6 — Production intelligence evaluation (meta.intentEvaluation; default on)
# INTENT_EVALUATION=true
# Run: npm run test:intent-p46
# Phase 4.7 — Adaptive optimization recommendations (meta.intentOptimization; advisory only; default on)
# Never applies thresholds or ranking changes; rollback: INTENT_OPTIMIZATION=false
# INTENT_OPTIMIZATION=true
# Run: npm run test:intent-p47
# Phase 4.8 — Intelligence governance (meta.intentGovernance; advisory only; default on)
# Policy enforcement is telemetry-only; rollback: INTENT_GOVERNANCE=false
# INTENT_GOVERNANCE=true
# Run: npm run test:intent-p48
# Phase 4.9 — Adaptive calibration (meta.intentCalibration; advisory only; default on)
# Weighting is telemetry-only; rollback: INTENT_CALIBRATION=false
# INTENT_CALIBRATION=true
# Run: npm run test:intent-p49
# Phase 5.0 — Controlled runtime activation (meta.intentRuntime; default OFF)
# Modes: telemetry-only | shadow-apply | bounded-apply | protected-canary | full-safe-runtime
# Production mutation requires INTENT_RUNTIME_PROD_APPLY=true or INTENT_RUNTIME_CANARY_APPLY=true
# INTENT_RUNTIME_ENABLED=false
# INTENT_RUNTIME_MODE=telemetry-only
# INTENT_RUNTIME_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p50
# Phase 5.1 — Adaptive orchestration (meta.intentOrchestration; default OFF)
# Modes: telemetry-only | passive-balance | shadow-orchestration | bounded-orchestration | protected-runtime | full-safe-orchestration
# Production requires INTENT_ORCHESTRATION_PROD_APPLY=true or INTENT_ORCHESTRATION_CANARY_APPLY=true
# INTENT_ORCHESTRATION_ENABLED=false
# INTENT_ORCHESTRATION_MODE=telemetry-only
# INTENT_ORCHESTRATION_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p51
# Phase 5.2 — Deterministic intelligence memory (meta.intentMemory; default OFF; no personalization)
# Query-context keys only; rollback restores pre-memory order
# INTENT_MEMORY_ENABLED=false
# INTENT_MEMORY_MODE=telemetry-only
# INTENT_MEMORY_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p52
# Phase 5.3 — Cross-intent coordination (meta.intentCoordination; default OFF; no personalization)
# Deterministic decomposition + reasoning graph; rollback restores pre-coordination order
# INTENT_COORDINATION_ENABLED=false
# INTENT_COORDINATION_MODE=telemetry-only
# INTENT_COORDINATION_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p53
# Phase 5.4 — Commerce intelligence fusion (meta.intentFusion; default OFF; no personalization)
# Bounded multi-signal blending; rollback restores pre-fusion order
# INTENT_FUSION_ENABLED=false
# INTENT_FUSION_MODE=telemetry-only
# INTENT_FUSION_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p54
# Phase 5.5 — Adaptive commerce reasoning (meta.adaptiveReasoning; default OFF; no personalization)
# Bounded reasoning chains; rollback restores pre-reasoning order
# ADAPTIVE_REASONING_ENABLED=false
# ADAPTIVE_REASONING_MODE=telemetry-only
# ADAPTIVE_REASONING_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p55
# Phase 5.6 — Commerce decision intelligence (meta.decisionIntelligence; default OFF; no personalization)
# Bounded purchase-decision synthesis; rollback restores pre-decision order
# DECISION_INTELLIGENCE_ENABLED=false
# DECISION_INTELLIGENCE_MODE=telemetry-only
# DECISION_INTELLIGENCE_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p56
# Phase 5.7 — Strategic commerce intelligence (meta.strategyIntelligence; default OFF; no personalization)
# Bounded market-aware ranking synthesis; rollback restores pre-strategy order
# STRATEGY_INTELLIGENCE_ENABLED=false
# STRATEGY_INTELLIGENCE_MODE=telemetry-only
# STRATEGY_INTELLIGENCE_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p57
# Phase 5.8 — Adaptive market intelligence (meta.marketIntelligence; default OFF; no personalization)
# Bounded market cognition synthesis; rollback restores pre-market order
# MARKET_INTELLIGENCE_ENABLED=false
# MARKET_INTELLIGENCE_MODE=telemetry-only
# MARKET_INTELLIGENCE_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p58
# Phase 5.9 — Behavioral commerce intelligence (meta.behavioralCommerce; default OFF; advisory/telemetry-first)
# Bounded behavioral cognition synthesis; rollback restores pre-behavioral order
# BEHAVIORAL_COMMERCE_ENABLED=false
# BEHAVIORAL_COMMERCE_MODE=telemetry-only
# BEHAVIORAL_COMMERCE_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p59
# Phase 6.0 — Unified commerce cognition engine (meta.cognitionEngine; default OFF; no personalization)
# Bounded unified cognition synthesis; rollback restores pre-cognition order
# COGNITION_ENGINE_ENABLED=false
# COGNITION_ENGINE_MODE=telemetry-only
# COGNITION_ENGINE_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p60
# Phase 6.1 — Intent cognition layer (meta.intentCognition; default OFF; query-derived only)
# Bounded intent cognition synthesis; rollback restores pre-intent order
# INTENT_COGNITION_ENABLED=false
# INTENT_COGNITION_MODE=telemetry-only
# INTENT_COGNITION_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p61
# Phase 6.2 — Multi-objective commerce reasoning (meta.multiObjectiveCommerce; default OFF; no personalization)
# Bounded quality+price+trust+value+intent+aesthetics+stability+conversion synthesis; rollback restores pre-multi-objective order
# MULTI_OBJECTIVE_COMMERCE_ENABLED=false
# MULTI_OBJECTIVE_COMMERCE_MODE=telemetry-only
# MULTI_OBJECTIVE_COMMERCE_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p62
# Phase 6.3 — Adaptive strategic ranking (meta.adaptiveStrategicRanking; default OFF; no personalization)
# Bounded trust/value + premium/affordability + conversion/stability + aesthetic/practicality synthesis; rollback restores pre-strategic order
# ADAPTIVE_STRATEGIC_RANKING_ENABLED=false
# ADAPTIVE_STRATEGIC_RANKING_MODE=telemetry-only
# ADAPTIVE_STRATEGIC_RANKING_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p63
# Phase 6.4 — Memoryless commerce learning (meta.memorylessCommerceLearning; default OFF; no user memory)
# Bounded aggregate telemetry learning; rollback restores pre-learning order; no user identity stored
# MEMORYLESS_COMMERCE_LEARNING_ENABLED=false
# MEMORYLESS_COMMERCE_LEARNING_MODE=telemetry-only
# MEMORYLESS_COMMERCE_LEARNING_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p64
# Phase 6.5 — Market reality intelligence (meta.marketRealityIntelligence; default OFF; no personalization)
# Bounded aggregate commerce telemetry; rollback restores pre-reality order; deterministic only
# MARKET_REALITY_INTELLIGENCE_ENABLED=false
# MARKET_REALITY_INTELLIGENCE_MODE=telemetry-only
# MARKET_REALITY_INTELLIGENCE_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p65
# Phase 6.6 — Commerce decision intelligence (meta.commerceDecisionIntelligence; default OFF; no personalization)
# Bounded final decision governance; rollback restores pre-decision order; deterministic only
# COMMERCE_DECISION_INTELLIGENCE_ENABLED=false
# COMMERCE_DECISION_INTELLIGENCE_MODE=telemetry-only
# COMMERCE_DECISION_INTELLIGENCE_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p66
# Phase 6.7 — Autonomous commerce reasoning graph (meta.autonomousCommerceReasoningGraph; default OFF; deterministic graph only)
# Bounded reasoning paths/chains; rollback restores pre-graph order; no autonomous agents
# AUTONOMOUS_COMMERCE_REASONING_GRAPH_ENABLED=false
# AUTONOMOUS_COMMERCE_REASONING_GRAPH_MODE=telemetry-only
# AUTONOMOUS_COMMERCE_REASONING_GRAPH_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p67
# Phase 6.8 — Unified cognitive governance (meta.unifiedCognitiveGovernance; default OFF; deterministic only)
# Cross-layer arbitration; rollback restores pre-governance order; no memory storage or autonomous agents
# COGNITIVE_GOVERNANCE_ENABLED=false
# COGNITIVE_GOVERNANCE_MODE=telemetry-only
# COGNITIVE_GOVERNANCE_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p68
# Phase 6.9 — Economic world simulation (meta.economicWorldSimulation; default OFF; deterministic only)
# Bounded economic pressure/ecosystem simulation; rollback restores pre-simulation order; no memory storage
# ECONOMIC_WORLD_SIMULATION_ENABLED=false
# ECONOMIC_WORLD_SIMULATION_MODE=telemetry-only
# ECONOMIC_WORLD_SIMULATION_EMERGENCY_SHUTDOWN=false
# Run: npm run test:intent-p69
# TASTE_GRAMMAR_SHADOW=true
